{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyCrone",
  "version": "0.1.0",
  "identifier": "com.jimkelley.rustycrone",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "RustyCrone", "width": 960, "height": 680, "minWidth": 640, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
